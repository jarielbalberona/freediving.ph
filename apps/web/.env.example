NEXT_PUBLIC_APP_URL=http://localhost:4001

# FPHGO API base URL (client-side requests)
NEXT_PUBLIC_FPHGO_BASE_URL=http://localhost:4000

# FPHGO API base URL (server-side requests). Falls back to NEXT_PUBLIC_FPHGO_BASE_URL if unset.
FPHGO_BASE_URL=http://localhost:4000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local SEO workbench. Mock is the safe default; DataForSEO credentials are
# only needed for explicitly confirmed live SEO tooling calls.
SEO_SERP_PROVIDER=mock
SEO_TARGET_BASE_URL=http://localhost:4001
SEO_SERP_CACHE_TTL_HOURS=168
SEO_SERP_MAX_RESULTS=10
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
